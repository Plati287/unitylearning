      document.getElementById("edit-mode-title").textContent = t("new_game");
      document.getElementById("admin-submit-btn").textContent = t("publish");
      
      document.getElementById("a-title").value = "";
      document.getElementById("a-desc").value = "";
      document.getElementById("a-link").value = "";
      document.getElementById("a-release-date").value = "";
      document.getElementById("a-trailer").value = "";
      document.getElementById("a-sneakpeeks").value = "";
      document.getElementById("a-featured").checked = false;
      clearGalleryForm();
      document.getElementById("admin-msg").textContent = "";
    };

    // ========== AUTENTICACION ==========
    onAuthStateChanged(auth, user => {
      currentUser = user;
      isAdmin = user?.email === ADMIN_EMAIL;
      updateNav();
      renderGames();
      if (isAdmin) showAdminPanel();
      else hideAdminPanel();
      
      if (currentUser && pendingGameLink) {
        window.open(pendingGameLink, "_blank");
        pendingGameLink = null;
      }
    });

    function updateNav() {
      const navAuth = document.getElementById("nav-auth");
      const navUser = document.getElementById("nav-user");
      if (currentUser) {
        navAuth.style.display = "none";
        navUser.style.display = "flex";
        document.getElementById("nav-email").textContent = currentUser.email;
      } else {
        navAuth.style.display = "flex";
        navUser.style.display = "none";
      }
    }

    window.registerUser = async function () {
      const email = document.getElementById("reg-email").value.trim();
      const pass = document.getElementById("reg-pass").value;
      const msg = document.getElementById("auth-msg");
      try {
        await createUserWithEmailAndPassword(auth, email, pass);
        await addDoc(collection(db, "subscribers"), { email, subscribedAt: serverTimestamp() });
        msg.textContent = t("subscribed_ok");
        msg.className = "auth-msg ok";
        setTimeout(() => closeModal("modal-auth"), 1500);
      } catch (e) {
        msg.textContent = errorMsg(e.code);
        msg.className = "auth-msg error";
      }
    };

    window.loginUser = async function () {
      const email = document.getElementById("login-email").value.trim();
      const pass = document.getElementById("login-pass").value;
      const msg = document.getElementById("auth-msg");
      try {
        await signInWithEmailAndPassword(auth, email, pass);
        msg.textContent = t("session_started");
        msg.className = "auth-msg ok";
        setTimeout(() => closeModal("modal-auth"), 1500);
      } catch (e) {
        msg.textContent = errorMsg(e.code);
        msg.className = "auth-msg error";
      }
    };

    window.logoutUser = async function () {
      await signOut(auth);
    };

    window.submitGame = async function () {
      const title = document.getElementById("a-title").value.trim();
      const description = document.getElementById("a-desc").value.trim();
      const link = document.getElementById("a-link").value.trim();
      const releaseDate = document.getElementById("a-release-date").value;
      const trailerUrl = document.getElementById("a-trailer").value.trim();
      const sneakPeeks = document.getElementById("a-sneakpeeks").value.trim();
      const featured = document.getElementById("a-featured").checked;
      const msg = document.getElementById("admin-msg");

      const galleryImagesList = [];
      for (let i = 0; i < 5; i++) {
        if (galleryImages[i] && galleryImages[i].trim() !== "") {
          galleryImagesList.push(galleryImages[i]);
        }
      }
      
      const externalImage = document.getElementById("a-img").value.trim();
      if (galleryImagesList.length === 0 && externalImage) {
        galleryImagesList.push(externalImage);
      }

      if (!title || !description) {
        msg.textContent = "Titulo y descripcion son obligatorios.";
        msg.className = "auth-msg error";
        return;
      }

      if (galleryImagesList.length === 0) {
        msg.textContent = "Debes seleccionar al menos una imagen de portada.";
        msg.className = "auth-msg error";
        return;
      }

      try {
        if (featured && !editingGameId) {
          const prev = allGames.filter(g => g.featured);
          for (const g of prev) {
            await updateDoc(doc(db, "games", g.id), { featured: false });
          }
        } else if (featured && editingGameId) {
          const prev = allGames.filter(g => g.featured && g.id !== editingGameId);
          for (const g of prev) {
            await updateDoc(doc(db, "games", g.id), { featured: false });
          }
        }

        const gameData = {
          title, description, galleryImages: galleryImagesList, link, releaseDate, trailerUrl, sneakPeeks, featured,
          updatedAt: serverTimestamp()
        };

        if (editingGameId) {
          await updateDoc(doc(db, "games", editingGameId), gameData);
          msg.textContent = t("game_updated");
        } else {
          gameData.createdAt = serverTimestamp();
          await addDoc(collection(db, "games"), gameData);
          await addDoc(collection(db, "notifications"), {
            type: "new_game", gameTitle: title, gameLink: link, sentAt: serverTimestamp()
          });
          msg.textContent = t("game_added");
        }
        
        msg.className = "auth-msg ok";
        cancelEdit();
        await loadGames();
      } catch (e) {
        msg.textContent = "Error: " + e.message;
        msg.className = "auth-msg error";
      }
    };

    async function deleteGame(id) {
      if (!confirm(t("delete_confirm"))) return;
      try {
        await deleteDoc(doc(db, "games", id));
        await loadGames();
      } catch (e) {
        alert("Error al eliminar: " + e.message);
      }
    }

    function showAdminPanel() {
      document.getElementById("admin-panel").style.display = "block";
      cancelEdit();
    }
    function hideAdminPanel() {
      document.getElementById("admin-panel").style.display = "none";
    }

    window.closeCta = function() {
      document.getElementById("register-cta").style.display = "none";
    };

    window.openModal = function (id) {
      document.getElementById(id).classList.add("open");
      document.getElementById("auth-msg").textContent = "";
    };
    window.closeModal = function (id) {
      document.getElementById(id).classList.remove("open");
    };
    document.querySelectorAll(".modal").forEach(m => {
      m.addEventListener("click", e => {
        if (e.target === m) m.classList.remove("open");
      });
    });

    window.showTab = function (tab) {
      document.getElementById("tab-register").style.display = tab === "register" ? "block" : "none";
      document.getElementById("tab-login").style.display = tab === "login" ? "block" : "none";
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      document.querySelector(`[data-tab="${tab}"]`).classList.add("active");
      document.getElementById("auth-msg").textContent = "";
    };

    function errorMsg(code) {
      const msgs = {
        "auth/email-already-in-use": "Ese email ya esta registrado.",
        "auth/invalid-email": "Email no valido.",
        "auth/weak-password": "Contraseña muy corta (minimo 6 caracteres).",
        "auth/user-not-found": "No existe cuenta con ese email.",
        "auth/wrong-password": "Contraseña incorrecta.",
        "auth/invalid-credential": "Email o contraseña incorrectos."
      };
      return msgs[code] || "Error inesperado. Intentalo de nuevo.";
    }

    loadGames();
  </script>

