      padding: 0.6rem;
      margin-bottom: 0.5rem;
      border-radius: 4px;
    }
    
    .gallery-upload h4 {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }
    
    .gallery-item {
      margin-bottom: 1rem;
      padding: 0.5rem;
      background: rgba(0,0,0,0.3);
      border-radius: 4px;
    }
    
    .gallery-item label {
      font-size: 0.7rem;
      margin-bottom: 0.25rem;
      display: block;
    }
    
    .gallery-item input {
      margin-bottom: 0.25rem;
    }
    
    .gallery-preview {
      display: none;
      max-width: 100%;
      height: auto;
      margin-top: 0.5rem;
      border-radius: 4px;
      max-height: 100px;
      object-fit: cover;
    }
    
    .or-divider {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      margin: 0.5rem 0;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.85);
      z-index: 200;
      align-items: center;
      justify-content: center;
    }
    .modal.open { display: flex; }

    .modal-box {
      background: var(--bg2);
      border: 1px solid var(--border);
      padding: 2rem;
      width: 100%;
      max-width: 400px;
      position: relative;
      border-radius: 12px;
    }

    .modal-close {
      position: absolute;
      top: 1rem; right: 1rem;
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.2rem;
      cursor: pointer;
    }
    .modal-close:hover { color: #fff; }

    .modal-title {
      font-family: var(--font-title);
      font-size: 1rem;
      color: #fff;
      margin-bottom: 1.5rem;
      letter-spacing: 0.05em;
    }

    .tabs {
      display: flex;
      gap: 0;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .tab-btn {
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      padding: 0.5rem 1rem;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
      cursor: pointer;
      letter-spacing: 0.05em;
      margin-bottom: -1px;
    }
    .tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }

    .modal input {
      width: 100%;
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.6rem 0.9rem;
      font-family: var(--font-body);
      font-size: 1rem;
      margin-bottom: 0.75rem;
      outline: none;
      border-radius: 4px;
    }
    .modal input:focus { border-color: var(--accent); }

    .auth-msg {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      min-height: 1.2rem;
      margin: 0.5rem 0;
    }
    .auth-msg.ok { color: #4caf50; }
    .auth-msg.error { color: var(--accent); }

    footer {
      padding: 2rem;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      letter-spacing: 0.1em;
    }

    @media (max-width: 600px) {
      nav { padding: 0.75rem 1rem; }
      .nav-logo { font-size: 0.9rem; }
      #hero { padding: 2rem 1rem; }
      #games { padding: 3rem 1rem; }
      .social-links { gap: 1rem; }
      .trailer-wrapper iframe { height: 200px; }
      .gallery-nav { width: 30px; height: 30px; font-size: 1rem; }
      #games-grid { grid-template-columns: 1fr; }
      .register-cta { bottom: 1rem; right: 1rem; left: 1rem; max-width: none; }
    }
  </style>
</head>
